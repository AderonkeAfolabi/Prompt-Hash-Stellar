# PromptHash auxiliary server (Express + MongoDB)
# Copy to server/.env when running the backend locally.

# Required for server features (draft lifecycle, buyer collections, chat)
MONGODB_URI=mongodb://127.0.0.1:27017/prompt-hash-stellar

# Optional — email notifications
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Optional — S3 backup (see docs/operations/backup-and-recovery.md)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# Optional — dependency-aware public health, GET /api/health (#1027)
# See docs/operations/public-health-endpoint.md.
# HEALTH_CACHE_TTL_MS=10000
# HEALTH_INDEXER_DEGRADED_AFTER_MS=60000
# HEALTH_INDEXER_DOWN_AFTER_MS=600000
# STELLAR_RPC_URL=            # falls back to PUBLIC_STELLAR_RPC_URL; unset = RPC not checked

# Optional — strict allow-list validation (#1025)
# See docs/operations/allow-list-validation.md.
#   enforce (default) – violations are rejected with a stable error code
#   report            – violations are logged but allowed (rollback lever)
# ALLOWLIST_MODE=enforce
# Comma-separated hosts; `*.example.com` matches subdomains. Unset = any public host.
# WEBHOOK_ALLOWED_HOSTS=
# IMAGE_ALLOWED_HOSTS=
# EVIDENCE_ALLOWED_HOSTS=

# Optional — projection replay CLI, `npm run projections:replay` (#1024)
# See docs/operations/event-replay.md.
# REPLAY_OPERATOR=            # actor recorded in the audit trail; defaults to $USER

# Optional — queue admission ceilings (#1009)
# See docs/operations/queue-backpressure.md. Values count pending + processing.
# Invalid values fall back to the type default; 0 disables the ceiling.
# JOB_QUEUE_MAX_PENDING_SETTLEMENT_POLL=1000
# JOB_QUEUE_MAX_PENDING_ENTITLEMENT_REPAIR=500
# JOB_QUEUE_MAX_PENDING_ANALYTICS_AGGREGATE=50
# JOB_QUEUE_MAX_PENDING_EXPORT_CSV=25
# JOB_QUEUE_MAX_PENDING_STALE_DISPUTE_CLEANUP=10
# JOB_QUEUE_MAX_PENDING_RETENTION_CLEANUP=5
# JOB_QUEUE_MAX_PENDING_STALE_CACHE_REPAIR=50

# Optional — trusted Ed25519 keys for imported external evidence (#1011)
# See docs/operations/external-evidence-verification.md. JSON array (or
# {"keys":[...]}). Empty/invalid configuration rejects every import.
# EXTERNAL_EVIDENCE_TRUSTED_KEYS=[{"keyId":"partner-key-1","issuer":"partner-a","publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","scopes":["evidence:submit"]}]
